{
  "version": 1,
  "default": "ask",
  "allow": [
    "src/**",
    "packages/**",
    "test/**",
    "tests/**",
    "*.{ts,js,tsx,jsx,py,go,rs,java}"
  ],
  "ask": [
    "docs/**",
    "specs/**",
    "manual_docs/**",
    "*.{md,mdx}",
    "*.config.*",
    "*.conf.*",
    "*.{yaml,yml,toml,ini}"
  ],
  "deny": [
    "*.env",
    "*.env.*",
    "*.{pem,key,cert,secret}"
  ]
}